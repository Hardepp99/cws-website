# Production — set in Hostinger Node.js environment variables

NEXT_PUBLIC_SITE_URL=https://cwsindia.online
CWS_NODE_CMS=1

MYSQL_HOST=localhost
MYSQL_DATABASE=your_database
MYSQL_USER=your_user
MYSQL_PASSWORD=your_password

CWS_UPLOAD_DIR=/path/to/data/uploads
REVALIDATE_SECRET=generate-long-random-secret
CWS_SESSION_SECRET=generate-long-random-secret

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_PLACES_API_KEY=
